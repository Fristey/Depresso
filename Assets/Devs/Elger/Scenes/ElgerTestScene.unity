      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: 'tutorials.Array.data[1].texts.Array.data[0]'
      value: 'This is your cat '
      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: 'tutorials.Array.data[1].texts.Array.data[1]'
      value: It has a tendency to push cups
      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: 'tutorials.Array.data[1].texts.Array.data[2]'
      value: And damage machines
      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: 'tutorials.Array.data[1].texts.Array.data[3]'
      value: That can be fixed with a wrench
      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: 'tutorials.Array.data[1].texts.Array.data[4]'
      value: 'You can distract it and calm down by playing with it '
      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: 'tutorials.Array.data[1].texts.Array.data[5]'
      value: But that only works for so long
      objectReference: {fileID: 0}
    - target: {fileID: 5263827538005195681, guid: 8dac5f29ae479c24da09eb2ac83d5ba5, type: 3}
      propertyPath: tutorials.Array.data[0].meshRenderers.Array.size
